<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="ecommercePU" transaction-type="RESOURCE_LOCAL">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>

        <!-- Déclaration des entités JPA -->
        <class>ma.fstt.atelier3.entities.Client</class>
        <class>ma.fstt.atelier3.entities.Categorie</class>
        <class>ma.fstt.atelier3.entities.Produit</class>
        <class>ma.fstt.atelier3.entities.Panier</class>
        <class>ma.fstt.atelier3.entities.LignePanier</class>
        <class>ma.fstt.atelier3.entities.Commande</class>
        <class>ma.fstt.atelier3.entities.LigneCommande</class>

        <properties>
            <!--Connexion JDBC MySQL-->
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/ecommerce_db?useSSL=false&amp;serverTimezone=UTC&amp;allowPublicKeyRetrieval=true&amp;createDatabaseIfNotExist=true"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value="/MySQL/@/255/@/"/>

            <!--genration automatique des tables dans MySQL-->
            <property name="eclipselink.ddl-generation" value="create-or-extend-tables"/>
            <property name="eclipselink.ddl-generation.output-mode" value="database"/>

            <!--Journalisation des requêtes SQL-->
            <property name="eclipselink.logging.level" value="FINE"/>
            <property name="eclipselink.logging.parameters" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
